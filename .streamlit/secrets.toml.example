# Copy this file to .streamlit/secrets.toml for LOCAL development
# (secrets.toml itself is gitignored — never commit a real key).
#
# For the deployed dashboard, do NOT create this file on Streamlit Cloud —
# instead paste the key into: App settings -> Secrets, in the same
# key = "value" format shown below.
#
# Get a key at https://console.anthropic.com/settings/keys — set a spending
# limit there too, since this dashboard is public and any visitor who clicks
# "Generate AI policy recommendation" triggers one API call.

ANTHROPIC_API_KEY = "sk-ant-..."
