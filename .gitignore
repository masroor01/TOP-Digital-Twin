# Satellite/climate raw extracted CSVs — reproducible from zip files via Script 14
# Zips sourced from Google Drive; run Script 14 to regenerate these folders
data/satellite_climate/raw/

# Market-zone features file (439 MB — all 2,495 markets × 17 zones × 470 weeks)
# Regenerate with: python scripts/14_Satellite_Climate_Features.py
# Primary model uses crop_weekly_features.csv (crop-average join); this is supplementary only
data/satellite_climate/market_zone_features.csv

# Master joined panel, all layers M0-M6 (696 MB — full market-level panel x 60 cols)
# Regenerate with: python scripts/22_Master_Panel_Join.py
data/master_weekly_panel_all_layers.csv

# Market-level Diebold-Mariano diagnostic predictions (159 MB — full market panel, 2 variants)
# Regenerate with: python scripts/15_Ablation_Study_M0_M4.py (MARKET_LEVEL_DIAGNOSTIC=True)
Model_Output/dm_market_level_predictions.csv

