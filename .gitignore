# Streamlit secrets (ANTHROPIC_API_KEY for the dashboard's AI recommendation
# feature) — never commit real keys. See .streamlit/secrets.toml.example.
.streamlit/secrets.toml

# CatBoost's per-run training log directory (Script 15b) — regenerated
# every run, not a real output (see table_tree_model_comparison*.csv instead)
catboost_info/

# =============================================================
# RAW AGMARKNET SOURCE FILES — EXCLUDED FROM VERSION CONTROL
# =============================================================
# These files are excluded because they exceed GitHub's 100 MB
# per-file limit (tomato: 383 MB, onion: 200 MB, potato: 85 MB).
#
# Source: Agmarknet (Agricultural Marketing Information Network)
#         Government of India, Directorate of Marketing & Inspection
#         https://agmarknet.gov.in → Price & Arrivals → Download
#
# To reproduce the processed weekly panels in data/agmarknet_weekly/,
# download the raw files from Agmarknet and place them in the same
# folder as scripts/09_Agmarknet_Weekly_Panel.py, then run:
#
#   python scripts/09_Agmarknet_Weekly_Panel.py
#
# Expected filenames:
#   tomato_all_india_apmcs_2000_2026.csv
#   onion_all_india_apmcs_2000_2025.csv
#   potato_all_india_apmcs_2000_2026.csv
# =============================================================
tomato_all_india_apmcs*.csv
onion_all_india_apmcs*.csv
potato_all_india_apmcs*.csv

# Agmarknet combined panel (107 MB — regenerated by Script 09 from crop-specific panels)
data/agmarknet_weekly/top_weekly_panel.csv

# Model outputs — track figures and metrics table, exclude large binaries
# Figures and metrics are committed for reproducibility and paper reference
# LightGBM trained model text dumps (large) and raw prediction files
Model_Output/lgbm_*.txt
Model_Output/test_predictions_2024.csv
